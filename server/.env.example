# HTTP port and bind address
PORT=3000
HOST=0.0.0.0

# Where the SQLite database, server secret and encrypted media live (mount a volume here)
DATA_DIR=./data

# Pepper for OTP hashes (>= 32 chars). Optional: generated and stored in DATA_DIR if empty.
SERVER_SECRET=

# SMS.ir verify template for login codes. Empty in development: codes print to the log.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAMETER_NAME=code

# Optional fixed codes for test numbers, e.g. 09120000000:123456 (never sends an SMS)
OTP_TEST_NUMBERS=

NODE_ENV=development
